{
  "name": "@nextenti/recruit-crm-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nextenti Recruit CRM — backend API (NestJS + Prisma + PostgreSQL + Redis/BullMQ)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx --env-file-if-exists=.env scripts/openapi.ts",
    "openapi:check": "tsx --env-file-if-exists=.env scripts/openapi.ts --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "migrate:zoho": "tsx --env-file=.env scripts/zoho-migrate.ts",
    "perf:check": "tsx --env-file=.env scripts/perf-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "prisma-generator-typescript-interfaces": "^3.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "fastify": "$fastify",
    "deepmerge-ts": "^8.0.0"
  }
}
